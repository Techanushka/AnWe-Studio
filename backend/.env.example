# Where the frontend runs (used for CORS, password-reset links and the Google sign-in redirect)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Where accounts, projects and uploaded videos are stored (default: backend/data)
# DATA_DIR=./data
MAX_UPLOAD_MB=2048
# 1 when the site is served over https
# COOKIE_SECURE=0

# Optional: Google sign-in. Authorised redirect URI in Google Cloud must equal GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional: send real password-reset emails. Without SMTP the reset link is printed in this console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Anwe Studio <you@example.com>

# Optional server-side transcription (pip install -r requirements-transcribe.txt)
# Model quality vs speed: large-v3 (best, GPU), medium, small (CPU friendly), base, tiny
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto
PRELOAD=0
