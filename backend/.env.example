# Model quality vs speed: large-v3 (best), medium, small (CPU friendly), base, tiny
WHISPER_MODEL=large-v3
# auto | cuda | cpu
WHISPER_DEVICE=auto
# GPU: float16   CPU: int8   (auto picks the fastest supported)
WHISPER_COMPUTE=auto
# Comma-separated list of frontend origins allowed to call this server
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=2048
# 1 = load the model at startup so the first request isn't slow
PRELOAD=1
