VITE_API_BASE_URL=/api
VITE_GOOGLE_AUTH_URL=/api/auth/google
VITE_DASHBOARD_URL=/dashboard
# Optional: max video upload size in MB for the dashboard upload card (default 2048)
VITE_MAX_UPLOAD_MB=2048

# Optional but recommended for the best transcript accuracy: URL of the transcription server in /backend.
# When set, videos are sent to it (large Whisper model) instead of being transcribed in the browser.
VITE_TRANSCRIBE_URL=
